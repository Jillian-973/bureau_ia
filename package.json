{
  "name": "bureau-ia",
  "version": "0.0.0",
  "private": true,
  "description": "Bureau d'agents IA: remote MCP server and HD-2D virtual office",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --mode mcp-app",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "wrangler types && tsc -b",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply bureau --local",
    "db:migrate:remote": "wrangler d1 migrations apply bureau --remote"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "easystarjs": "^0.4.4",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
