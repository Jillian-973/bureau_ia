{
  // Cloudflare Worker code. Runtime and binding types come from
  // `worker-configuration.d.ts`, generated by `wrangler types`.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": ["src/worker", "src/shared", "tests/worker", "worker-configuration.d.ts"]
}
